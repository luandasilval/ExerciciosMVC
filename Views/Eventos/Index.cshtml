@model List<Evento>
@{
    ViewData["Title"] = "Listagem de eventos";
}

<H1>Listagem geral de eventos</H1>
<table>
    <tr>
        <th>Id</th>
        <th>Nome</th>
        <th>Email</th>
        <th>Idade</th>
        <th></th>
    </tr>
    @foreach (Evento evento in Model)
    {
        <tr>
            <td>@evento.Id</td>
            <td>@evento.Nome</td>
            <td>@evento.Descricao</td>
            <td>@evento.Local</td>
            <td>@evento.DataEvento</td>
            <td>@evento.QuantidadeVagas</td>
            <td>@evento.ValorIngresso</td>
            <td>
                <a asp-action="Detalhes" asp-route-id="@evento.Id">Ver</a>
            </td>
        </tr>
    }
</table>